id = dark ? '#2c2c2a' : '#e1e0d9';\n  var nocu = { id: 'nocu', beforeDatasetsDraw: function (c) { if (!d.nocu) return; var x = c.scales.x, a = c.chartArea, g = c.ctx,\n    x0 = x.getPixelForValue(d.nocu[0]), x1 = x.getPixelForValue(d.nocu[1]);\n    g.save(); g.fillStyle = 'rgba(137,135,129,0.10)'; g.fillRect(x0, a.top, x1 - x0, a.bottom - a.top);\n    g.fillStyle = muted; g.font = '11px sans-serif'; g.textAlign = 'center';\n    g.fillText('No cumulus', (x0 + x1) / 2, a.top + (a.bottom - a.top) / 2); g.restore(); } };\n  var band = { id: 'band', beforeDatasetsDraw: function (c) { if (!d.up) return; var x = c.scales.x, a = c.chartArea, g = c.ctx;\n    g.save(); g.fillStyle = 'rgba(137,135,129,0.14)';\n    g.fillRect(x.getPixelForValue(d.up[0]), a.top, x.getPixelForValue(d.up[1]) - x.getPixelForValue(d.up[0]), a.bottom - a.top); g.restore(); } };\n  // Landmarks on the slope (Sam, 10-31): dashed lines across the chart.\n  var marks = { id: 'marks', beforeDatasetsDraw: function (c) { var y = c.scales.y, a = c.chartArea, g = c.ctx;\n    [[4600, 'Treeline'], [6200, 'Ferns']].forEach(function (m) {\n      if (m[0] < y.min || m[0] > y.max) return; var py = y.getPixelForValue(m[0]);\n      g.save(); g.strokeStyle = muted; g.lineWidth = 1; g.setLineDash([4, 4]);\n      g.beginPath(); g.moveTo(a.left, py); g.lineTo(a.right, py); g.stroke();\n      g.setLineDash([]); g.fillStyle = muted; g.font = '11px sans-serif'; g.textAlign = 'right';\n      g.fillText(m[1], a.right - 4, py - 4); g.restore(); }); } };\n  var hm = function (m) { return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0'); };\n  var ys = d.derived.map(function (a) { return a[1]; }).concat(d.forecast.map(function (a) { return a[1]; })).concat(d.camera.map(function (a) { return a[1]; })).concat(d.proj.map(function (a) { return a[1]; }));\n  var xs = [540, 960];\n  var ymin = Math.min(3500, Math.floor(Math.min.apply(null, ys) / 500) * 500);\n  new Chart(document.getElementById('basechart'), {\n    type: 'line',\n    data: { datasets: [\n      { label: 'Derived', data: d.derived.map(pt), borderColor: '#2a78d6', borderWidth: 2, pointRadius: 0, tension: 0.3 },\n      { label: 'Forecast', data: d.forecast.map(pt), borderColor: '#eb6834', borderWidth: 2, borderDash: [6, 4], pointRadius: 3, pointBackgroundColor: '#eb6834', tension: 0.3 },\n      { label: 'Forecast (sounding)', data: d.proj.map(pt), borderColor: '#8a5cd6', borderWidth: 2, borderDash: [3, 4], pointRadius: 0, tension: 0.3 },\n      { label: 'Kekoa camera', data: d.camera.map(pt), showLine: false, pointRadius: 3, pointBackgroundColor: '#3f9d5a', borderColor: '#3f9d5a' },\n      { label: 'Camera hidden', data: d.hidden.map(function (m) { return {x: m, y: ymin}; }), showLine: false, clip: false,\n         pointRadius: 3, pointBackgroundColor: '#e0a100', borderColor: '#e0a100' },\n      { label: 'Camera, no call', data: d.nocall.map(function (m) { return {x: m, y: ymin}; }), showLine: false, clip: false,\n         pointRadius: 3, pointBorderWidth: 1.5, pointBackgroundColor: 'rgba(0,0,0,0)', borderColor: muted }\n    ] },\n    options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'nearest', axis: 'x', intersect: false },\n      plugins: { legend: { display: false }, tooltip: { callbacks: {\n        title: function (i) { return hm(i[0].parsed.x); },\n        label: function (i) { return i.dataset.label === 'Camera hidden' ? 'Camera hidden: cloud or rain at the camera'\n          : i.dataset.label === 'Camera, no call' ? 'Camera: no call'\n          : i.dataset.label + ': ' + Math.round(i.parsed.y).toLocaleString() + ' ft'; } } } },\n      scales: {\n        x: { type: 'linear', min: xs[0], max: xs[1], ticks: { stepSize: 60, color: muted, callback: function (v) { return hm(v); } }, grid: { display: false } },\n        y: { min: ymin,\n              max: Math.max(7000, Math.ceil(Math.max.apply(null, ys) / 500) * 500),\n              ticks: { stepSize: 500, color: muted, callback: function (v) { return v.toLocaleString(); } }, grid: { color: grid } }\n      } },\n    plugins: [nocu, marks]\n  });\n})();\n</script>", "line": "Crossing Kula Highway near Omaopio<div class=\"sub\">Most of the day, 39 updates. Furthest south about 17:22: Crossing Kula Highway at the middle Lower Kula Road junction</div>", "up": "<span class=\"num\">08:15</span> to about <span class=\"num\">16:45</span>", "wind": "<span class=\"num\">3 mph</span>, gusts to 12<div class=\"sub\">Lower elevations, during the upslope</div>"}