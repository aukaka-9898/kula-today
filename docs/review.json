nction (v) { return hm(v); } }, grid: { display: false } },\n        y: { min: ymin,\n              max: Math.max(7000, Math.ceil(Math.max.apply(null, ys) / 500) * 500),\n              ticks: { stepSize: 500, color: muted, callback: function (v) { return v.toLocaleString(); } }, grid: { color: grid } }\n      } },\n    plugins: [nocu, marks]\n  });\n})();\n</script>", "line": "On Makawao Avenue near Makawao, running toward Kahului<div class=\"sub\">Most of the day, 47 updates. Furthest south about 08:28: Crossing Kula Highway between the middle Lower Kula Road junction and Waiakoa</div>", "up": "<span class=\"num\">08:15</span> to about <span class=\"num\">16:00</span>", "wind": "<span class=\"num\">3 mph</span>, gusts to 9<div class=\"sub\">Lower elevations, during the upslope</div>"}